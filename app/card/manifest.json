{
    "_version": "1.14.0",
    "sap.app": {
        "id": "ordersbyshipper",
        "type": "card",
        "title": "Orders by Shipper",
        "subTitle": "UI5 Integration Card of Type List",
        "applicationVersion": {
            "version": "1.0.0"
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "phone": true,
            "tablet": true
        },
        "icons": {
            "icon": "sap-icon://list"
        }
    },
    "sap.card": {
        "type": "List",
        "designtime": "dt/configuration",
        "header": {
            "title": "Orders by Shipper {filters>/shipper/selectedItem/title}",
            "subTitle": "These are the top sellers this month",
            "icon": {
                "src": "sap-icon://desktop-mobile"
            },
            "status": {
                "text": "{= ${/@odata.count} ? ${/@odata.count} : ${/value}.length }"
            }
        },
        "data": {
            "request": {
                "url": "https://services.odata.org/V4/Northwind/Northwind.svc/Orders",
                "parameters": {
                    "$count": true,
                    "$filter": "Shipper/ShipperID eq {filters>/shipper/value}"
                }
            },
            "path": "/value"
        },
        "configuration": {
            "destinations": {
                "Northwind": {
                    "name": "Northwind",
                    "label": "Northwind V4 Service URL",
                    "defaultUrl": "https://services.odata.org/V4/Northwind/Northwind.svc"
                }
            },
            "filters": {
                "shipper": {
                    "value": "{parameters>/selectedShipperID/value}",
                    "type": "Select",
                    "label": "Shipper",
                    "item": {
                        "path": "/value",
                        "template": {
                            "key": "{ShipperID}",
                            "title": "{CompanyName}"
                        }
                    },
                    "data": {
                        "request": {
                            "url": "https://services.odata.org/V4/Northwind/Northwind.svc/Shippers"
                        }
                    }
                }
            },
            "parameters": {
                "title": {
                    "value": "Orders by Shipper"
                },
                "maxOrdersShown": {
                    "value": "4",
                    "type": "integer",
                    "label": "Numbers of orders",
                    "description": "How many orders to show in the list."
                },
                "selectedShipperID": {
                    "value": 3,
                    "label": "The default selected shipper"
                }
            }
        },
        "content": {
            "item": {
                "title": "{ShipName}",
                "description": "{ShipAddress}",
                "info": {
                    "value": "{ShipCountry}"
                }
            },
            "maxItems": "{parameters>/maxOrdersShown/value}"
        }
    },
    "sap.platform.mobilecards": {
        "compatible": false
    },
    "sap.cloud": {
        "public": true,
        "service": "bookshopmtx"
    }
}