{
  "name": "minimalsample-mtx",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^3",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "log": {
      "format": "plain"
    },
    "features": {
      "kibana_formatter": "false"
    },
    "profile": "mtx-sidecar",
    "requires": {
      "html5-repo": true,
      "destinations": true,
      "[hybrid]": {
        "db": {
          "kind": "hana-mt"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "t1": {
            "tenant": "t1",
            "roles": [
              "cds.Subscriber",
              "internal-user"
            ]
          }
        }
      }
    }
  }
}