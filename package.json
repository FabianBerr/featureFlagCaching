{
  "name": "minimalsample",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^3",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "profile": "with-mtx-sidecar",
    "requires": {
      "toggles": true,
      "[production]": {
        "multitenancy": true
      },
      "[with-mtx]": {
        "multitenancy": true
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "t1": {
            "tenant": "t1",
            "roles": [
              "cds.Subscriber",
              "internal-user"
            ]
          },
          "t2": {
            "tenant": "t2",
            "roles": [
              "cds.Subscriber",
              "internal-user"
            ]
          }
        },
        "tenants": {
          "t1": {
            "features": [
              "isbn"
            ]
          },
          "t2": {
            "features": []
          }
        }
      }
    }
  }
}