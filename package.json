{
  "name": "minimalsample",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/resilience": "^4.4.0",
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^3",
    "@sap/xsenv": "^6.0.0",
    "@sap/xssec": "^4",
    "axios": "^1.13.4",
    "cds-caching": "^1.1.0",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.16.3"
  },
  "scripts": {
    "start": "cds-serve",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "undeploy": "cf undeploy minimalsample --delete-services --delete-service-keys --delete-service-brokers",
    "watch:sidecar": "cds watch mtx/sidecar",
    "watch:withmtx": "cds watch --profile with-mtx"
  },
  "private": true,
  "cds": {
    "profile": "with-mtx-sidecar",
    "requires": {
      "toggles": true,
      "[production]": {
        "multitenancy": true,
        "db": {
          "kind": "hana-mt"
        },
        "auth": {
          "kind": "xsuaa"
        }
      },
      "[with-mtx]": {
        "multitenancy": true
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "t1": {
            "tenant": "t1",
            "roles": [
              "cds.Subscriber",
              "internal-user"
            ]
          },
          "t2": {
            "tenant": "t2",
            "roles": [
              "cds.Subscriber",
              "internal-user"
            ]
          }
        },
        "tenants": {
          "t1": {
            "features": [
              "isbn"
            ]
          },
          "t2": {
            "features": []
          }
        }
      },
      "caching": {
        "impl": "cds-caching",
        "namespace": "caching",
        "store": "sqlite",
        "keyManagement": {
          "isTenantAware": true
        },
        "credentials": {
          "url": "sqlite://./cache.sqlite",
          "table": "cache",
          "busyTimeout": 10000
        }
      },
      "bp-caching": {
        "impl": "cds-caching",
        "namespace": "bp-caching"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/admin-books",
    "app/browse"
  ]
}