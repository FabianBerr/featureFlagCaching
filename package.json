{
  "name": "minimalsample",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.10",
    "@keyv/redis": "^5.1.6",
    "@sap-cloud-sdk/resilience": "^4.4.0",
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^3",
    "@sap/xsenv": "^6.0.0",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@keyv/sqlite": "^4.0.8",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.16.3"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "cds-serve",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "undeploy": "cf undeploy minimalsample --delete-services --delete-service-keys --delete-service-brokers",
    "watch:sidecar": "npx cds watch mtx/sidecar",
    "watch:withmtx": "npx cds build && npx cds watch --profile with-mtx",
    "watch:hybrid": "cds build --production && cds watch --profile hybrid"
  },
  "private": true,
  "cds": {
    "log": {
      "format": "plain"
    },
    "features": {
      "kibana_formatter": "false"
    },
    "profile": "with-mtx-sidecar",
    "requires": {
      "toggles": true,
      "[hybrid]": {
        "multitenancy": true,
        "db": {
          "kind": "hana-mt"
        }
      },
      "[production]": {
        "multitenancy": true,
        "db": {
          "kind": "hana-mt"
        },
        "auth": {
          "kind": "xsuaa"
        }
      },
      "[with-mtx]": {
        "multitenancy": true
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "t1": {
            "tenant": "t1",
            "roles": [
              "cds.Subscriber",
              "internal-user"
            ]
          },
          "t2": {
            "tenant": "t2",
            "roles": [
              "cds.Subscriber",
              "internal-user"
            ]
          },
          "t3": {
            "tenant": "t3",
            "roles": [
              "cds.Subscriber",
              "internal-user"
            ]
          }
        },
        "tenants": {
          "t1": {
            "features": [
              "isbn"
            ]
          },
          "t2": {
            "features": []
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/admin-books",
    "app/browse"
  ]
}